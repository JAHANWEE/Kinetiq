{
  "expo": {
    "name": "Kinetiq",
    "slug": "Kinetiq",
    "version": "1.0.0",
    "scheme": "kinetiq",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1020"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Kinetiq to access your device motion to analyze driving behavior."
        }
      ],
      "expo-image"
    ]
  }
}
